{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokbuild.local/qa/scenario.schema.json",
  "title": "GrokBuild parity scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "priority", "reference", "profile", "workspaceFixture", "steps", "assert"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swiftCommit", "grokVersion"],
      "properties": {
        "swiftCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "grokVersion": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "locale", "timeZone", "appearance", "reduceMotion"],
      "properties": {
        "clock": { "type": "string", "format": "date-time" },
        "locale": { "type": "string" },
        "timeZone": { "type": "string" },
        "appearance": { "enum": ["light", "dark"] },
        "reduceMotion": { "type": "boolean" }
      }
    },
    "workspaceFixture": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "minProperties": 1 } },
    "assert": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string" },
        "rpc": { "type": "string" },
        "filesystem": { "type": "string" },
        "accessibility": { "type": "string" },
        "screenshots": { "type": "array", "items": { "type": "string" } }
      },
      "minProperties": 1
    }
  }
}

