{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "electron", "vitest/globals"],
    "lib": ["ES2023"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
